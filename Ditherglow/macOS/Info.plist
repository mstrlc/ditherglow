<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ditherglow.app proxies the appcast attached to the latest GitHub release and counts checks. -->
	<key>SUFeedURL</key>
	<string>https://ditherglow.app/appcast.xml</string>
	<!-- Check daily without Sparkle's second-launch prompt; still switchable in Settings. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Public half of the EdDSA key in the maintainer's Keychain (Sparkle's generate_keys). -->
	<key>SUPublicEDKey</key>
	<string>PfAMmGCKA8nVW3o4zU7fJTg43oWnjQGn0PZWIS7VuzA=</string>
	<!-- Only asked when the user picks "Current Location" in Settings. -->
	<key>NSLocationUsageDescription</key>
	<string>Ditherglow uses your approximate location so the sky's colours follow the sun where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ditherglow uses your approximate location so the sky's colours follow the sun where you are.</string>
</dict>
</plist>
